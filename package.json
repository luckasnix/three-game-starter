{
  "name": "three-game-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Three.js starter for web and desktop games.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "type:check": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "lint:check": "oxlint --deny-warnings .",
    "lint:write": "oxlint --fix ."
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-opener": "2.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@12.10.1"
}
